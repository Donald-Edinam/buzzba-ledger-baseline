# Which provider a run uses: anthropic | gemini | groq | openrouter | ollama
# See docs/PROVIDERS.md for cost, rate limits and the fairness rule.
LLM_PROVIDER=anthropic

# Set the key for the provider selected above; the others can stay blank.
ANTHROPIC_API_KEY=sk-ant-api03-...
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ollama needs no key

# Model name. Optional: each provider has a default in src/llm/factory.ts.
# Provider-specific: if you switch LLM_PROVIDER, change or unset this too, or a
# Claude model name gets sent to Gemini.
MODEL=claude-sonnet-5

# Optional override of the provider's base URL (proxy, non-default Ollama port).
# LLM_BASE_URL=

# Application Environment Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Reasoning budget for OpenAI-compatible providers: none | low | medium | high.
# Gemini 3.x reasons by default and those tokens are billed against max_tokens;
# see the Thinking tokens section of docs/PROVIDERS.md. Never sent to Anthropic.
REASONING_EFFORT=low

# Per-request timeout in ms. High reasoning levels can take minutes.
LLM_TIMEOUT_MS=180000
